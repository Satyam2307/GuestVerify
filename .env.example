# ==========================================
# GuestVerify Environment Configuration Template
# Copy this file to .env and insert your secure values.
# NEVER commit .env to version control!
# ==========================================

# Amazon Bedrock AWS Credentials
# Required for Claude 3.5 Haiku visitor intent analysis
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# Application Environment Mode
# Options: development | production
ENVIRONMENT=production

# Ring Webhook Authentication Token
# Required header: X-Ring-Token for production webhook validation
RING_WEBHOOK_TOKEN=your_secure_random_ring_webhook_token

# Demo Mode (Simulate locks without external hardware integration)
DEMO_MODE=true

# Security & CORS Settings
# Restrict to your custom production domains and local development
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://guestverify.ai,https://www.guestverify.ai

# Optional Admin Authentication Key for privileged endpoints
ADMIN_API_KEY=your_secure_admin_api_key_here

# Rate Limiting
RATE_LIMIT_ENABLED=true
